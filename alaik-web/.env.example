# Base URL of the Alaik API. Defaults to http://localhost:5050 when unset.
# For a Capacitor production build, set this to your hosted API origin, then `npm run build`.
VITE_API_URL=http://localhost:5050

# Monetization (see docs/MONETIZATION.md). Optional in dev; required on device.
# RevenueCat iOS public SDK key (subscriptions):
VITE_REVENUECAT_IOS_KEY=
# AdMob banner ad unit ids (free-tier ads):
VITE_ADMOB_IOS_BANNER=
VITE_ADMOB_ANDROID_BANNER=
# AdMob interstitial (full-screen) ad unit ids:
VITE_ADMOB_IOS_INTERSTITIAL=
VITE_ADMOB_ANDROID_INTERSTITIAL=
